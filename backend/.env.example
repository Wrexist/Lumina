# Lumina ephemeris backend — copy to backend/.env for local dev.
# In production these are set via Fly.io secrets / GH Actions secrets.

# Port the Fastify server listens on. Default 3001.
PORT=3001

# Bind address. Default 127.0.0.1 (localhost). Set to 0.0.0.0 in containers.
HOST=127.0.0.1

# Shared secret expected on every /chart request as `X-Lumina-Secret`.
# The iOS app reads this from $(SWISS_EPH_API_SECRET) at build time.
# Generate: `openssl rand -hex 32`
LUMINA_API_SECRET=

# Optional: per-IP fixed-window rate limit (defaults shown).
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# Optional: log level. trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# Anthropic — powers the /interpret LLM endpoint ("Ask your chart", daily
# reading). The key lives ONLY here, server-side; it is NEVER shipped in the
# iOS app (a client-side key is extractable from the IPA). Leave blank and
# /interpret returns 503 while the rest of the service runs normally.
# Production: `fly secrets set ANTHROPIC_API_KEY=sk-ant-... --app lumina-ephemeris`
ANTHROPIC_API_KEY=
# Optional: model + token budget for interpretations (defaults shown).
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=2048
